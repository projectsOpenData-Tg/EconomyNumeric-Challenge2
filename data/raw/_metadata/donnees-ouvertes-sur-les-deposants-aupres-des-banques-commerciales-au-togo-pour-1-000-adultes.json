{"acronym": "DDBC-TG", "archived": null, "badges": [], "contact_point": null, "created_at": "2025-01-21T15:02:20.099000+00:00", "deleted": null, "description": "Les d\u00e9posants aupr\u00e8s des banques commerciales correspondent au nombre d\u00e9clar\u00e9 de titulaires de comptes de d\u00e9p\u00f4t aupr\u00e8s de banques commerciales et d'autres banques r\u00e9sidentes fonctionnant comme des banques commerciales qui sont des soci\u00e9t\u00e9s non financi\u00e8res r\u00e9sidentes (publiques et priv\u00e9es) et des m\u00e9nages. Pour de nombreux pays, les donn\u00e9es couvrent le nombre total de comptes de d\u00e9p\u00f4t en raison du manque d'informations sur les titulaires de comptes. Les principaux types de d\u00e9p\u00f4ts sont les comptes courants, les comptes d'\u00e9pargne et les d\u00e9p\u00f4ts \u00e0 terme. Lien vers la source:[cliquez ici](https://api.worldbank.org/v2/country/TGO/indicators/FB.CBK.DPTR.P3)", "extras": {}, "frequency": "irregular", "frequency_date": "2023-12-31T00:00:00+00:00", "harvest": null, "id": "678fb6fc39ebe7a073f26c04", "internal": {"created_at_internal": "2025-01-21T15:02:20.099000+00:00", "last_modified_internal": "2025-01-21T15:03:18.279000+00:00"}, "last_modified": "2025-01-21T15:03:18.279000+00:00", "last_update": "2025-01-21T15:03:18.275000+00:00", "license": "CC-BY-4.0", "metrics": {"discussions": 0, "followers": 0, "resources_downloads": 14, "reuses": 0, "views": 30}, "organization": {"acronym": "BM", "badges": [{"kind": "company"}], "class": "Organization", "id": "677c053226455eb8e960aaca", "logo": "https://opendata.gouv.tg/s/avatars/0e/cb33bd4c5446be8975b3fc46dc70e8-original.png", "logo_thumbnail": "https://opendata.gouv.tg/s/avatars/0e/cb33bd4c5446be8975b3fc46dc70e8-100.png", "name": "Banque Mondiale", "page": "https://opendata.gouv.tg/fr/organizations/banque-mondiale/", "slug": "banque-mondiale", "uri": "https://opendata.gouv.tg/api/1/organizations/banque-mondiale/"}, "owner": null, "page": "https://opendata.gouv.tg/f